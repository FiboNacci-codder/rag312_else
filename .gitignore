# Entornos y ejecutables pesados
conda/

# Contenedores Apptainer (binarios muy grandes)
containers/*.sif

# Datos de la base vectorial (regenerables)
qdrant_storage/

# Modelos descargados (HF cache, fastembed cache)
modelos/

# Salidas del pipeline de ingesta (regenerables con ocr_docling.py / embeddings.py)
salida_md/
salida_chunks/
datos/

# Outputs de corridas de eval (regenerables con eval_retrieval.py / eval_generation.py / filtrar_golden_set.py)
tests/eval/resultados_*.json
tests/eval/filtrado_reporte*.json

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Artefactos de `pip install -e .`
*.egg-info/
build/
dist/

# Archivos de caché de pruebas (opcional, pero recomendado)
tests/**/__pycache__/
tests/**/*.pyc
